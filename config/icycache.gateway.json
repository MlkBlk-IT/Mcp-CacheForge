{
  "proxy": {
    "host": "127.0.0.1",
    "port": 8080,
    "timeout": 120
  },
  "mcp": {
    "host": "127.0.0.1",
    "port": 8081,
    "transport": ["stdio", "sse"]
  },
  "mcp_gateway": {
    "host": "127.0.0.1",
    "port": 8083,
    "transport": ["stdio", "sse"],
    "_note": "Serveur MCP de la gateway. 8081 est servi par mcp_server.py (serveur MCP)."
  },
  "gateway": {
    "host": "127.0.0.1",
    "port": 8082,
    "default_upstream": "omniroute",
    "ws_delta_interval_s": 0.25,
    "_note": "default_upstream = defaut EXPLICITE de la config (pas de fallback code vers OmniRoute). null = le client doit nommer son upstream (prefixe /<upstream>/v1/..., header X-IcyCache-Upstream ou champ 'upstream')."
  },
  "upstreams": {
    "omniroute": {"base_url": "http://localhost:20128", "kind": "openai"},
    "lmstudio":  {"base_url": "http://localhost:1234",  "kind": "openai"},
    "ollama":    {"base_url": "http://localhost:11434", "kind": "openai"},
    "openai":    {"base_url": "https://api.openai.com", "kind": "openai"},
    "anthropic": {"base_url": "https://api.anthropic.com", "kind": "anthropic"}
  },
  "cache": {
    "db_path": "D:\\IcyCache\\db\\cache.db",
    "max_entries": 10000,
    "enable_semantic": false,
    "semantic_threshold": 0.95,
    "ttl_seconds": 86400,
    "cache_when_temperature_unset": true,
    "embeddings_ttl_seconds": 604800
  },
  "loop_guard": {
    "enabled": true,
    "window_seconds": 300,
    "tools": {"warn_after": 3, "block_after": 5, "max_cycle_len": 3},
    "llm": {"warn_after": 3, "action": "warn", "block_after": 6}
  },
  "tool_cache": {
    "enabled": true,
    "default": "deny",
    "max_result_bytes": 1048576,
    "downstream": {},
    "policy": {},
    "_example": {
      "downstream": {"srv1": {"transport": "stdio", "command": "node", "args": ["server.js"]}},
      "policy": {"srv1.nom_du_tool": {"ttl_seconds": 60}}
    }
  },
  "normalization": {
    "remove_politeness": true,
    "canonical_synonyms": {
      "config": "configuration",
      "setup": "configuration",
      "stp": "",
      "s'il te pla\u00eet": "",
      "please": "",
      "can you": "",
      "peux-tu": ""
    }
  },
  "logging": {
    "level": "INFO",
    "file": "D:\\IcyCache\\logs\\app.log",
    "max_size_mb": 10
  }
}
